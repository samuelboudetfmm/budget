# --- IA (OpenRouter) ---
OPENROUTEURAPI=sk-or-v1-...
# Modèle par défaut (modifiable ensuite dans Réglages)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Boîte mail des tickets (IMAP IDLE : réception instantanée) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=tickets@example.com
IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_TLS=true
# IMAP_TLS_INSECURE=false   # true si le serveur a un certificat auto-signé

# --- Webhook mail optionnel (Cloudflare Email Worker, Mailgun…) ---
# INBOUND_EMAIL_TOKEN=une-longue-chaine-aleatoire

# --- Banque (Enable Banking, DSP2 lecture seule) ---
# ENABLE_BANKING_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Chemin de la clé privée dans le conteneur (le dossier ./data est monté sur /app/data)
# ENABLE_BANKING_KEY_PATH=/app/data/enablebanking.pem
